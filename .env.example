PORT=5000
NODE_ENV=development

# MongoDB connection (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/crystal-agencies
#   or for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crystalAgencies

# JWT
JWT_SECRET=your_secret_key_here
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
# Optional — separate signing secrets for access/refresh tokens
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# JWT_ACCESS_TTL=
# JWT_REFRESH_TTL=

# write to terminal to get JWT_SECRET or any code
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# App base URL — used for email verification / password reset links
# APP_URL=https://your-store.example.com
# CLIENT_URL=https://your-store.example.com

# SMTP / Email (Nodemailer)
# Leave blank to run in simulate mode (console.log only).
#
# — Gmail users: use SMTP_HOST=smtp.gmail.com with a Google "App Password".
#   Your regular Gmail password will NOT work for SMTP (Google blocks it).
#   Create an App Password here: https://myaccount.google.com/apppasswords
#   Recommended: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true
#   Or (STARTTLS):  SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_SECURE=false
#   NOTE: DO NOT set SMTP_HOST to "gmail.com" (it's smtp.gmail.com).
#
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# MAIL_FROM_NAME=Crystal Agencies
# MAIL_FROM_ADDRESS=no-reply@crystalagencies.example
# SUPPORT_EMAIL=support@crystalagencies.example

# Email (Gmail SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your_app_password_here
# MAIL_FROM_NAME=Crystal Agencies
# MAIL_FROM_ADDRESS=your-email@gmail.com
# SUPPORT_EMAIL=support@crystalagencies.com

# # App URLs
# APP_URL=http://localhost:3000
# CLIENT_URL=http://localhost:3000